{
  "name": "invoices",
  "private": true,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm db:up && pnpm --parallel --filter @invoices/api --filter @invoices/web dev",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "idoklad:fetch": "tsx tools/idoklad/fetch.ts"
  },
  "devDependencies": {
    "nx": "^21.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5",
    "tsx": "^4.20.0"
  }
}
